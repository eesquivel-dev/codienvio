# App
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-secret
AUTH_SECRET=change-me-to-a-long-random-secret

# PostgreSQL (docker compose default)
DATABASE_URL=postgresql://codienvio:codienvio@localhost:5432/codienvio

# Envia.com — sandbox token from https://shipping-test.envia.com/settings/developers
# Never expose this to the browser. Portal and API always call Envia from the server.
ENVIA_TOKEN=
ENVIA_ENVIRONMENT=sandbox
# sandbox: https://api-test.envia.com  production: https://api.envia.com
ENVIA_BASE_URL=https://api-test.envia.com
ENVIA_QUERIES_URL=https://queries.test.envia.com

# Set to true to quote/buy without a real Envia token (demo rates + PDF).
ENVIA_MOCK=false
